[Icon Theme]
Name=Valkyrie
Comment=Valkyrie plum and lavender icon theme
Inherits=Adwaita,hicolor
Directories=scalable/places,scalable/mimetypes,scalable/devices,scalable/status,scalable/actions

[scalable/places]
Size=128
Type=Scalable
MinSize=16
MaxSize=256
Context=Places

[scalable/mimetypes]
Size=128
Type=Scalable
MinSize=16
MaxSize=256
Context=MimeTypes

[scalable/devices]
Size=128
Type=Scalable
MinSize=16
MaxSize=256
Context=Devices

[scalable/status]
Size=128
Type=Scalable
MinSize=16
MaxSize=256
Context=Status

[scalable/actions]
Size=128
Type=Scalable
MinSize=16
MaxSize=256
Context=Actions
